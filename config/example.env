# 端口统一要求:
# - 所有服务端口位于 60000-65534
# - 当前默认分配:
#   S3 API             61080
#   Admin Web UI       61081
#   OAuth Callback     61082
#   Metrics / Health   61083

# 数据面主入口: 本地 S3 兼容 API
CCBG_BIND_ADDR=127.0.0.1:61080

# 控制面与 UI 模式规划
CCBG_ADMIN_MODE=web
# 软路由默认建议保持 admin/callback/metrics 只监听 127.0.0.1，
# 通过 SSH 隧道、反向代理或受控管理网口转发，不要直接裸露到 LAN/WAN。
CCBG_ADMIN_BIND_ADDR=127.0.0.1:61081
CCBG_AUTH_CALLBACK_BIND_ADDR=127.0.0.1:61082
CCBG_METRICS_BIND_ADDR=127.0.0.1:61083
CCBG_CONTROL_PLANE_FILE=./data/control-plane.json
# provider 认证覆盖文件目录:
# - unicom.json
# - telecom.json
# - mobile.json
# - onedrive.json
# Admin Web 保存后会立即热注入对应 provider
CCBG_CREDENTIALS_DIR=./data/provider-credentials
# provider 动作模板目录:
# - browser-flows 负责浏览器侧动作编排
# - provider-bridges 负责 gateway/auth UI 与 browser-flow 之间的 provider-specific 绑定
# - provider-capabilities 负责稳定 native 动作模板
# 修改模板时优先替换 JSON，而不是改 provider 代码
CCBG_PROVIDER_BRIDGE_CATALOG_DIR=./config/provider-bridges
CCBG_PROVIDER_CAPABILITY_CATALOG_DIR=./config/provider-capabilities

# China Mobile native provider:
# - 所有真实对象都应落到单一托管根目录下，避免直接散落在云盘根目录
# - native capability catalog 负责 file/create、list、后续 upload/complete 等动作模板
# - 浏览器/CDP 只用于抓取会话与协议事实，不应承接生产写路径
CCBG_MOBILE_ROOT_PREFIX=ccbg-managed
CCBG_MOBILE_NATIVE_CAPABILITY_CATALOG_FILE=

# 自动抓取 / auth-broker / LLM 分析:
# - 小内存设备建议只跑 gateway-lite，把 auth capture 指向另一台 x86/x64 设备
# - 这些值也可在 Admin Web 中保存到 control-plane 文件
CCBG_AUTH_CAPTURE_ENABLED=false
CCBG_AUTH_CAPTURE_BROKER_URL=
CCBG_AUTH_CAPTURE_CDP_ENDPOINT_URL=http://127.0.0.1:9222
CCBG_AUTH_CAPTURE_CDP_TARGET_SELECTOR=
CCBG_AUTH_CAPTURE_CDP_TARGET_TIMEOUT_MS=15000
CCBG_AUTH_CAPTURE_LLM_ANALYSIS_ENABLED=false
CCBG_AUTH_CAPTURE_LLM_ENDPOINT=http://192.168.1.36:1234/v1
CCBG_AUTH_CAPTURE_LLM_MODEL_ID=supergemma4-26b-uncensored-v2
CCBG_AUTH_CAPTURE_LLM_API_KEY=
CCBG_AUTH_CAPTURE_LLM_API_KEY_FILE=

# Agent 封装规划
# MCP transport:
# - stdio: 默认，适合本地 Agent 直接拉起子进程
# - streamable_http: 可选，适合远程或多客户端接入
CCBG_MCP_TRANSPORT=stdio
CCBG_MCP_HTTP_BIND_ADDR=127.0.0.1:61084
CCBG_MCP_HTTP_ENDPOINT=/mcp

# 选择唯一写入主云盘: unicom | telecom | mobile | stub
# 兼容说明:
# - 新配置使用 CCBG_PRIMARY_PROVIDER
# - 旧的 CCBG_PROVIDER 后续视为兼容字段
CCBG_PRIMARY_PROVIDER=unicom

# 本地 S3 兼容层
CCBG_S3_REGION=us-east-1
CCBG_S3_FORCE_PATH_STYLE=true
CCBG_S3_ACCESS_KEY_ID=ccbg
# 必须替换默认示例值。若数据面要对非本机客户端开放，这是第一条必须完成的项。
CCBG_S3_SECRET_ACCESS_KEY=change-me
# 控制面独立 API key，用于 Admin Web、/api/*、/healthz、/readyz、/metrics。
# 支持 x-api-key、Authorization: Bearer <key>，以及浏览器首次通过 ?api_key=... 引导出 cookie。
CCBG_CONTROL_API_KEY=
CCBG_CONTROL_API_KEY_FILE=

# 当前数据面仍是非流式对象路径，因此建议显式限制对象内存上限
# 通用开发环境默认 8 MiB
# OpenWRT 建议起步值 4 MiB: 4194304
CCBG_MAX_IN_MEMORY_OBJECT_BYTES=8388608
# 数据面轻量并发上限。超限时立即返回 503，不排队，避免小宿主被瞬时并发拖爆。
# 通用开发环境默认 8；软路由 / OpenWRT 建议从 2~4 起步。
CCBG_DATA_PLANE_MAX_IN_FLIGHT=8
# 数据面每秒请求上限。0 表示关闭；启用后按 1 秒窗口限流，超限立即返回 503。
# 软路由如需更保守，可从 8~16 req/s 起步，再按客户端行为上调。
CCBG_DATA_PLANE_MAX_REQUESTS_PER_SECOND=0

# 异步同步目标，逗号分隔
# 规则:
# - 不应包含当前 primary provider
# - 可包含其他运营商云盘
# - 默认建议始终包含 onedrive
CCBG_SYNC_TARGETS=onedrive

# fallback 读取顺序，逗号分隔
# 留空表示只做异步同步，不做 fallback 读取
# 如需 fallback，通常建议把 onedrive 放在最后
CCBG_FALLBACK_READ_ORDER=onedrive

# 可选: 标记一个或多个“高速” provider，供路由策略与控制面展示使用。
# 这里不改变现有 primary/sync/fallback 语义，而是提供独立标签，便于后续实现
# “优先写高速盘”或“高速盘优先读”等可插拔策略。
# 示例: unicom,telecom
CCBG_HIGH_SPEED_PROVIDERS=

# OneDrive 作用域策略:
# - replication_enabled/fallback_enabled 可在 Admin Web 中直接修改并立即影响新写入/新 fallback 判定
# - primary provider / sync targets / fallback read order 也可在 Admin Web 中保存，并立即热切换
# - memory_only 适合只把 Hermes / OpenClaw 的记忆桶或记忆前缀同步到 OneDrive
CCBG_ONEDRIVE_REPLICATION_ENABLED=true
CCBG_ONEDRIVE_FALLBACK_ENABLED=true
CCBG_ONEDRIVE_POLICY_MODE=all
CCBG_ONEDRIVE_MEMORY_BUCKETS=
CCBG_ONEDRIVE_MEMORY_PREFIXES=

# 复制与 fallback 策略规划
CCBG_REPLICATION_MODE=async_backup
CCBG_REPLICATION_WORKERS=2
CCBG_REPLICATION_RECENT_LIMIT=64
CCBG_REPLICATION_MAX_ATTEMPTS=3
CCBG_REPLICATION_BASE_RETRY_DELAY_MS=1000
CCBG_REPLICATION_MAX_RETRY_DELAY_MS=30000
CCBG_OBJECT_ACTION_HISTORY_LIMIT=12
CCBG_METADATA_DB_PATH=./data/ccbg.db
CCBG_METADATA_SNAPSHOT_RECENT_LIMIT=32
CCBG_METADATA_COMPLETED_HISTORY_LIMIT=512
CCBG_METADATA_FAILED_HISTORY_LIMIT=256
CCBG_NOTIFY_WEBHOOK_URL=
# webhook 启用后总会发送 x-ccbg-notify-event-id 与 x-ccbg-notify-timestamp，供接收端做幂等与时间窗校验
# 可选。若设置，会额外发送 x-ccbg-notify-signature-version=v1 与 x-ccbg-notify-signature，签名算法为 hex(HMAC_SHA256(secret, "<timestamp>.<sha256(body)>"))
CCBG_NOTIFY_WEBHOOK_SIGNING_SECRET=
CCBG_NOTIFY_WEBHOOK_SIGNING_SECRET_FILE=
# webhook 轮询告警状态的最小间隔，默认 15s；小于 5 会自动提升到 5
CCBG_NOTIFY_POLL_INTERVAL_SECONDS=15

# 日志级别
RUST_LOG=info,gatewayd=debug,provider_unicom=debug,provider_telecom=debug,provider_mobile=debug,provider_onedrive=debug,policy_engine=debug,replication_engine=debug

# 中国联通云盘
CCBG_UNICOM_BASE_URL=https://panservice.mail.wo.cn
CCBG_UNICOM_TOKEN=
CCBG_UNICOM_TOKEN_FILE=
CCBG_UNICOM_COOKIE_HEADER=
CCBG_UNICOM_COOKIE_HEADER_FILE=
# auto | ipv4 | ipv6
CCBG_UNICOM_IP_FAMILY=auto
# 建议留空。网关会优先复用已捕获的真实浏览器请求画像，其次回退到当前 CDP 浏览器探测到的人格；只有在必须强制覆盖时才填写。
CCBG_UNICOM_USER_AGENT=
CCBG_UNICOM_TIMEOUT_SECS=30
CCBG_UNICOM_REQUEST_ORIGIN=https://pan.wo.cn
CCBG_UNICOM_REQUEST_REFERER=https://pan.wo.cn/
CCBG_UNICOM_HEADER_CLIENT_ID=1001000021
CCBG_UNICOM_APP_VERSION=5g-h5
# 下列 dispatcher_* 参数来自联通网页前端固定协议字段，不是你的个人凭据；除非上游改版，一般保持默认值即可
CCBG_UNICOM_DISPATCHER_CLIENT_ID=1001000021
CCBG_UNICOM_DISPATCHER_CHANNEL=wohome
CCBG_UNICOM_DISPATCHER_SECRET=Py1J67PAQoCb8Iel
CCBG_UNICOM_AUTH_PROBE_OPERATION=QueryAllFiles
CCBG_UNICOM_AUTH_PROBE_STYLE=wohome-secret
CCBG_UNICOM_AUTH_PROBE_BODY_JSON={"spaceType":"0","parentDirectoryId":"0","pageNum":0,"pageSize":50,"sortRule":0}
# 可选。设置后会显式启用联通家庭云 scope，并映射成 `family` bucket；如留空，会尝试通过 QueryFamilyGroups 自动发现
CCBG_UNICOM_FAMILY_ID=
CCBG_UNICOM_FAMILY_SPACE_TYPE=1
CCBG_UNICOM_FAMILY_ROOT_DIRECTORY_ID=0
# 可选。设置后会把联通云盘中的所有网关对象收口到同一个托管目录，例如 `ccbg-managed/root/...`
CCBG_UNICOM_ROOT_PREFIX=ccbg-managed
# 可选写入保护阈值。支持纯字节或单位，例如 10GiB / 200GB。
CCBG_UNICOM_QUOTA_MIN_FREE=
CCBG_UNICOM_QUOTA_MAX_USED=
CCBG_UNICOM_QUOTA_MIN_FREE_PERSONAL=
CCBG_UNICOM_QUOTA_MAX_USED_PERSONAL=
CCBG_UNICOM_QUOTA_MIN_FREE_FAMILY=
CCBG_UNICOM_QUOTA_MAX_USED_FAMILY=
# upload2C 默认跟随观测到的浏览器上传端点；如上游切换，可改这里
CCBG_UNICOM_UPLOAD_URL=https://bjupload.pan.wo.cn:32443/openapi/client/upload2C
# 8 MiB 与当前网页上传器一致；如上游仍接受更小分块，可按设备内存继续调低
CCBG_UNICOM_UPLOAD_CHUNK_SIZE_BYTES=8388608
# 可选。覆盖联通默认 native capability catalog；如留空，则从 CCBG_PROVIDER_CAPABILITY_CATALOG_DIR/unicom-native.json 加载
CCBG_UNICOM_NATIVE_CAPABILITY_CATALOG_FILE=./config/provider-capabilities/unicom-native.json

# 中国电信云盘
CCBG_TELECOM_BASE_URL=https://cloud.189.cn
CCBG_TELECOM_BROWSER_ID=
CCBG_TELECOM_BROWSER_ID_FILE=
CCBG_TELECOM_TOKEN=
CCBG_TELECOM_TOKEN_FILE=
CCBG_TELECOM_COOKIE_HEADER=
CCBG_TELECOM_COOKIE_HEADER_FILE=
# 可选；配置后会把电信家庭云暴露成 family 容器，且需要上面的 Access Token 一起使用
CCBG_TELECOM_FAMILY_ID=
# auto | ipv4 | ipv6
# 天翼云盘网页会话可能绑定出口 IP；若 token/Browser-Id 在 IPv4 会话中抓取，建议这里显式设为 ipv4
CCBG_TELECOM_IP_FAMILY=auto
# 建议留空。网关会优先复用已捕获的真实浏览器请求画像，其次回退到当前 CDP 浏览器探测到的人格；只有在必须强制覆盖时才填写。
CCBG_TELECOM_USER_AGENT=
CCBG_TELECOM_TIMEOUT_SECS=30
CCBG_TELECOM_SIGN_TYPE=1
# 默认个人云根目录；Web 管理页也可热注入覆盖
CCBG_TELECOM_ROOT_FOLDER_ID=-11
CCBG_TELECOM_PAGE_SIZE=60
# 可选写入保护阈值。支持纯字节或单位，例如 10GiB / 200GB。
CCBG_TELECOM_QUOTA_MIN_FREE=
CCBG_TELECOM_QUOTA_MAX_USED=
CCBG_TELECOM_QUOTA_MIN_FREE_PERSONAL=
CCBG_TELECOM_QUOTA_MAX_USED_PERSONAL=
CCBG_TELECOM_QUOTA_MIN_FREE_FAMILY=
CCBG_TELECOM_QUOTA_MAX_USED_FAMILY=

# 中国移动云盘
CCBG_MOBILE_BASE_URL=https://yun.139.com
# 建议填完整 Authorization header 值，例如 Bearer ...
CCBG_MOBILE_TOKEN=
CCBG_MOBILE_TOKEN_FILE=
CCBG_MOBILE_COOKIE_HEADER=
CCBG_MOBILE_COOKIE_HEADER_FILE=
# 当前主文件列表接口；如上游换域名或分区，可改这里
CCBG_MOBILE_LIST_URL=https://personal-kd-njs.yun.139.com/hcy/file/list
CCBG_MOBILE_PERSONAL_DISK_INFO_URL=https://user-njs.yun.139.com/user/disk/getPersonalDiskInfo
CCBG_MOBILE_FAMILY_DISK_INFO_URL=https://user-njs.yun.139.com/user/disk/getFamilyDiskInfo
# 从已登录浏览器当前会话中抓到的 parentFileId / userDomainId；Admin Web 的 Capture Current Session 可热注入
CCBG_MOBILE_ROOT_FOLDER_ID=
CCBG_MOBILE_USER_DOMAIN_ID=
# auto | ipv4 | ipv6
CCBG_MOBILE_IP_FAMILY=auto
# 建议留空。网关会优先复用已捕获的真实浏览器请求画像，其次回退到当前 CDP 浏览器探测到的人格；只有在必须强制覆盖时才填写。
CCBG_MOBILE_USER_AGENT=
CCBG_MOBILE_TIMEOUT_SECS=30
CCBG_MOBILE_PAGE_SIZE=100
# 中国移动显式哈希上传默认按 20 MiB 分片。若上游返回不同 partInfos，可保留默认值；如需更保守的单片内存峰值，可下调。
CCBG_MOBILE_UPLOAD_PART_SIZE_BYTES=20971520
# 中国移动 file/create 对 partInfos 数量存在上限。默认 41，与当前真实网页上传抓包相符。
CCBG_MOBILE_UPLOAD_MAX_PART_COUNT=41
# 可选写入保护阈值。支持纯字节或单位，例如 10GiB / 200GB。
CCBG_MOBILE_QUOTA_MIN_FREE=
CCBG_MOBILE_QUOTA_MAX_USED=

# OneDrive 默认备份同步目标
CCBG_ONEDRIVE_ENABLED=false
CCBG_ONEDRIVE_TENANT=common
CCBG_ONEDRIVE_CLIENT_ID=
CCBG_ONEDRIVE_USE_DEVICE_CODE=false
CCBG_ONEDRIVE_REDIRECT_URL=http://127.0.0.1:61082/auth/onedrive/callback
CCBG_ONEDRIVE_DRIVE_ID=
CCBG_ONEDRIVE_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
CCBG_ONEDRIVE_AUTH_BASE_URL=https://login.microsoftonline.com
CCBG_ONEDRIVE_SCOPES=offline_access Files.ReadWrite User.Read openid profile
CCBG_ONEDRIVE_SESSION_FILE=./data/onedrive-session.json
CCBG_ONEDRIVE_TOKEN=
CCBG_ONEDRIVE_TOKEN_FILE=
CCBG_ONEDRIVE_ROOT_PREFIX=carrier-cloud-blob-gateway
CCBG_ONEDRIVE_USER_AGENT=carrier-cloud-blob-gateway/0.1
CCBG_ONEDRIVE_TIMEOUT_SECS=30
# 可选写入保护阈值。支持纯字节或单位，例如 10GiB / 200GB。
CCBG_ONEDRIVE_QUOTA_MIN_FREE=
CCBG_ONEDRIVE_QUOTA_MAX_USED=
