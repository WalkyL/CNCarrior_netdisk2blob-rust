# OpenWRT host 起步配置
# 目标:
# - 在多数 OpenWRT 设备上先稳定跑 host 服务
# - 限制内存峰值和本地存储消耗

CCBG_BIND_ADDR=0.0.0.0:61080

# OpenWRT 档位建议先从单主写开始
CCBG_PRIMARY_PROVIDER=unicom
CCBG_SYNC_TARGETS=
CCBG_FALLBACK_READ_ORDER=

# 限制非流式对象路径的峰值内存
CCBG_MAX_IN_MEMORY_OBJECT_BYTES=4194304

# 复制与状态持久化
CCBG_REPLICATION_MODE=async_backup
CCBG_REPLICATION_WORKERS=1
CCBG_REPLICATION_RECENT_LIMIT=16
CCBG_METADATA_DB_PATH=/overlay/ccbg/ccbg.db
CCBG_METADATA_SNAPSHOT_RECENT_LIMIT=16
CCBG_METADATA_COMPLETED_HISTORY_LIMIT=64
CCBG_METADATA_FAILED_HISTORY_LIMIT=64

# 本地 S3 兼容层
CCBG_S3_REGION=us-east-1
CCBG_S3_FORCE_PATH_STYLE=true
CCBG_S3_ACCESS_KEY_ID=ccbg
CCBG_S3_SECRET_ACCESS_KEY=change-me

# OpenWRT 建议先关闭高成本 OneDrive
# 确认资源足够后再按需启用
CCBG_ONEDRIVE_ENABLED=false

# 降低日志量，减少 flash 写入压力
RUST_LOG=warn
