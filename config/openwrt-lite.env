# OpenWRT host 起步配置
# 目标:
# - 在多数 OpenWRT 设备上先稳定跑 host 服务
# - 限制内存峰值和本地存储消耗

CCBG_BIND_ADDR=0.0.0.0:61080
CCBG_CONTROL_PLANE_FILE=/overlay/ccbg/control-plane.json
CCBG_CREDENTIALS_DIR=/overlay/ccbg/provider-credentials

# Lite host 默认不本地跑自动抓取，建议委托给另一台大内存设备
CCBG_AUTH_CAPTURE_ENABLED=false
CCBG_AUTH_CAPTURE_BROKER_URL=
CCBG_AUTH_CAPTURE_LLM_ANALYSIS_ENABLED=false
CCBG_AUTH_CAPTURE_LLM_ENDPOINT=
CCBG_AUTH_CAPTURE_LLM_MODEL_ID=
CCBG_AUTH_CAPTURE_LLM_API_KEY=
CCBG_AUTH_CAPTURE_LLM_API_KEY_FILE=

# OpenWRT 档位建议先从单主写开始
CCBG_PRIMARY_PROVIDER=unicom
CCBG_SYNC_TARGETS=
CCBG_FALLBACK_READ_ORDER=

# 如运营商网页会话与出口 IPv4/IPv6 绑定，可按 provider 单独强制
# 如需联通家庭云探测，可额外提供 CCBG_UNICOM_FAMILY_ID 到更大内存的 full-host / auth-broker 节点
CCBG_UNICOM_IP_FAMILY=auto
CCBG_TELECOM_IP_FAMILY=auto
CCBG_MOBILE_IP_FAMILY=auto

# 限制非流式对象路径的峰值内存
CCBG_MAX_IN_MEMORY_OBJECT_BYTES=4194304

# 复制与状态持久化
CCBG_REPLICATION_MODE=async_backup
CCBG_REPLICATION_WORKERS=1
CCBG_REPLICATION_RECENT_LIMIT=16
CCBG_REPLICATION_MAX_ATTEMPTS=3
CCBG_REPLICATION_BASE_RETRY_DELAY_MS=2000
CCBG_REPLICATION_MAX_RETRY_DELAY_MS=60000
CCBG_METADATA_DB_PATH=/overlay/ccbg/ccbg.db
CCBG_METADATA_SNAPSHOT_RECENT_LIMIT=16
CCBG_METADATA_COMPLETED_HISTORY_LIMIT=64
CCBG_METADATA_FAILED_HISTORY_LIMIT=64

# 本地 S3 兼容层
CCBG_S3_REGION=us-east-1
CCBG_S3_FORCE_PATH_STYLE=true
CCBG_S3_ACCESS_KEY_ID=ccbg
CCBG_S3_SECRET_ACCESS_KEY=change-me

# OpenWRT 建议先关闭高成本 OneDrive
# 确认资源足够后再按需启用
CCBG_ONEDRIVE_ENABLED=false

# 降低日志量，减少 flash 写入压力
RUST_LOG=warn
