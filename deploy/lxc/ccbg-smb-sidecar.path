[Unit]
Description=Watch CCBG control plane for SMB sidecar changes

[Path]
PathModified=/var/lib/ccbg/control-plane.json
PathChanged=/etc/ccbg/ccbg.env
Unit=ccbg-smb-sidecar-sync.service

[Install]
WantedBy=multi-user.target
