# Safe PVE/LXC baseline. Replace S3/admin secrets before exposing beyond a lab.

RUST_LOG=warn

CCBG_BIND_ADDR=0.0.0.0:61080
CCBG_ADMIN_MODE=web
CCBG_ADMIN_BIND_ADDR=127.0.0.1:61081
CCBG_AUTH_CALLBACK_BIND_ADDR=127.0.0.1:61082
CCBG_METRICS_BIND_ADDR=127.0.0.1:61083

CCBG_PRIMARY_PROVIDER=stub
CCBG_SYNC_TARGETS=
CCBG_FALLBACK_READ_ORDER=
CCBG_ONEDRIVE_ENABLED=false
CCBG_ONEDRIVE_REPLICATION_ENABLED=false

CCBG_S3_REGION=us-east-1
CCBG_S3_FORCE_PATH_STYLE=true
CCBG_S3_ACCESS_KEY_ID=ccbg
CCBG_S3_SECRET_ACCESS_KEY=change-me
CCBG_CONTROL_API_KEY=change-me-control-api-key

CCBG_CONTROL_PLANE_FILE=/var/lib/ccbg/control-plane.json
CCBG_CREDENTIALS_DIR=/var/lib/ccbg/provider-credentials
CCBG_INSTANCE_ID_FILE=/var/lib/ccbg/instance-id
CCBG_METADATA_DB_PATH=/var/lib/ccbg/ccbg.db
CCBG_BODY_SPOOL_DIR=/var/lib/ccbg/body-spool
CCBG_PROVIDER_BRIDGE_CATALOG_DIR=/etc/ccbg/config/provider-bridges
CCBG_PROVIDER_CAPABILITY_CATALOG_DIR=/etc/ccbg/config/provider-capabilities
CCBG_BROWSER_FLOW_CATALOG_DIR=/etc/ccbg/config/browser-flows

CCBG_MAX_IN_MEMORY_OBJECT_BYTES=8388608
CCBG_MAX_SPOOLED_OBJECT_BYTES=3221225472
CCBG_SPOOLED_BODY_CHUNK_BYTES=1048576
CCBG_DATA_PLANE_MAX_IN_FLIGHT=8
CCBG_DATA_PLANE_MAX_REQUESTS_PER_SECOND=0
CCBG_REPLICATION_MODE=async_backup
CCBG_REPLICATION_WORKERS=1
CCBG_REPLICATION_RECENT_LIMIT=16
CCBG_METADATA_SNAPSHOT_RECENT_LIMIT=16
CCBG_METADATA_COMPLETED_HISTORY_LIMIT=64
CCBG_METADATA_FAILED_HISTORY_LIMIT=64
