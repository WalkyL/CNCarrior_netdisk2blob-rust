#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: LicenseRef-CCBG-Commercial
# Copyright (c) 2026 walky

START=95
STOP=10
USE_PROCD=1

SERVICE_NAME="ccbg"
ENV_FILE="${CCBG_ENV_FILE:-/etc/ccbg/openwrt-lite.env}"
GATEWAYD_BIN="${CCBG_GATEWAYD_BIN:-/usr/bin/gatewayd}"

start_service() {
	mkdir -p /overlay/ccbg /overlay/ccbg/provider-credentials /tmp/ccbg-spool
	chmod 0700 /overlay/ccbg /overlay/ccbg/provider-credentials /tmp/ccbg-spool 2>/dev/null || true
	procd_open_instance "${SERVICE_NAME}"
	procd_set_param command /bin/sh -c ". '${ENV_FILE}'; exec '${GATEWAYD_BIN}'"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param file "${ENV_FILE}"
	procd_close_instance
}

reload_service() {
	stop
	start
}
